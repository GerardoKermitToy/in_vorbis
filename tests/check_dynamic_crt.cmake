cmake_minimum_required(VERSION 3.24...4.4)

foreach(required IN ITEMS LINKER PLUGIN ARCHIVES CONFIG)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required} for dynamic CRT verification.")
    endif()
endforeach()

function(dump_binary result option path)
    execute_process(COMMAND "${LINKER}" /dump /nologo "${option}" "${path}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Could not inspect ${path}: ${output}\n${errors}")
    endif()
    string(TOLOWER "${output}" output)
    set(${result} "${output}" PARENT_SCOPE)
endfunction()

if(CONFIG STREQUAL "Debug")
    set(crt msvcrtd)
    set(other_crt msvcrt)
    set(suffix d)
else()
    set(crt msvcrt)
    set(other_crt msvcrtd)
    set(suffix "")
endif()

foreach(archive IN LISTS ARCHIVES)
    dump_binary(directives /directives "${archive}")
    if(directives MATCHES "[/-]defaultlib:\"?(libcmt|libcpmt|libucrt|libvcruntime)d?(\"|[ \t\r\n]|$)"
       OR directives MATCHES "[/-]defaultlib:\"?${other_crt}(\"|[ \t\r\n]|$)")
        message(FATAL_ERROR "${archive} contains a static or mismatched CRT directive.")
    endif()
    # /MD and /MDd select MSVCRT and MSVCRTD. MSVC /GL archives may expose no
    # directives; cmake/dynamic_crt.h checks every source's CRT macros at build
    # time, including debug/release agreement, before these archives are made.
    if(directives MATCHES "[/-]defaultlib:\"?${crt}(\"|[ \t\r\n]|$)")
        message(STATUS "${archive}: ${crt} DLL runtime")
    elseif(LTO)
        message(STATUS "${archive}: DLL runtime enforced at compile time (LTO)")
    else()
        message(FATAL_ERROR "${archive} does not select the ${crt} DLL runtime.")
    endif()
endforeach()

dump_binary(imports /dependents "${PLUGIN}")
foreach(runtime IN ITEMS vcruntime140 msvcp140)
    if(NOT imports MATCHES "${runtime}${suffix}\\.dll")
        message(FATAL_ERROR "${PLUGIN} does not import ${runtime}${suffix}.dll.")
    endif()
endforeach()
if(CONFIG STREQUAL "Debug")
    if(NOT imports MATCHES "ucrtbased\\.dll")
        message(FATAL_ERROR "The Debug plugin does not import ucrtbased.dll.")
    endif()
else()
    if(NOT imports MATCHES "(api-ms-win-crt-[a-z0-9-]+|ucrtbase)\\.dll")
        message(FATAL_ERROR "The plugin does not import the Windows Universal CRT.")
    endif()
    if(imports MATCHES "(ucrtbased|vcruntime140d|msvcp140d)\\.dll")
        message(FATAL_ERROR "A distributable plugin must not import the Debug runtime.")
    endif()
endif()
message(STATUS "${PLUGIN}: dynamic UCRT, VCRUNTIME, and MSVC C++ runtime imports verified")
