#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_FILE_INFO DIALOGEX 0, 0, 520, 342
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "File Information"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "File / URL", -1, 7, 7, 506, 35
    LTEXT           "Location:", IDC_INFO_PATH_LABEL, 15, 21, 42, 10
    EDITTEXT        IDC_INFO_PATH, 58, 19, 447, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP

    GROUPBOX        "Tags", -1, 7, 47, 294, 260
    LTEXT           "Title:", -1, 15, 61, 49, 10
    EDITTEXT        IDC_TAG_TITLE, 70, 59, 223, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Artist:", -1, 15, 80, 49, 10
    EDITTEXT        IDC_TAG_ARTIST, 70, 78, 223, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Album:", -1, 15, 99, 49, 10
    EDITTEXT        IDC_TAG_ALBUM, 70, 97, 223, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Track:", -1, 15, 118, 49, 10
    EDITTEXT        IDC_TAG_TRACK, 70, 116, 223, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Date:", -1, 15, 137, 49, 10
    EDITTEXT        IDC_TAG_DATE, 70, 135, 223, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Genre:", -1, 15, 156, 49, 10
    EDITTEXT        IDC_TAG_GENRE, 70, 154, 223, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Comment:", -1, 15, 175, 49, 10
    EDITTEXT        IDC_TAG_COMMENT, 70, 173, 223, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Other Tags:", -1, 15, 194, 54, 10
    CONTROL         "", IDC_TAG_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 15, 205, 278, 50
    LTEXT           "Name:", -1, 15, 263, 30, 10
    EDITTEXT        IDC_TAG_NAME, 47, 261, 93, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Value:", -1, 145, 263, 29, 10
    EDITTEXT        IDC_TAG_VALUE, 177, 261, 116, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add / Update", IDC_TAG_ADD_UPDATE, 125, 281, 84, 14, WS_TABSTOP
    PUSHBUTTON      "Delete", IDC_TAG_DELETE, 215, 281, 78, 14, WS_TABSTOP

    GROUPBOX        "File / Stream Information", -1, 309, 47, 204, 260
    EDITTEXT        IDC_INFO_DETAILS, 317, 61, 188, 151, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_INFO_WRITABLE_REASON, 317, 216, 188, 20
    GROUPBOX        "Logical Stream", -1, 317, 240, 188, 59
    PUSHBUTTON      "Previous", IDC_CHAIN_PREVIOUS, 325, 256, 57, 14, WS_TABSTOP
    PUSHBUTTON      "Next", IDC_CHAIN_NEXT, 440, 256, 57, 14, WS_TABSTOP
    CTEXT           "", IDC_CHAIN_LABEL, 385, 258, 52, 10
    LTEXT           "Changes are written only when Save is selected.", -1, 325, 278, 172, 10

    LTEXT           "", IDC_INFO_STATUS, 7, 318, 381, 10
    DEFPUSHBUTTON   "Save", IDC_INFO_SAVE, 400, 316, 51, 15, WS_TABSTOP
    PUSHBUTTON      "Close", IDC_INFO_CLOSE, 457, 316, 56, 15, WS_TABSTOP
END

IDD_CONFIG DIALOGEX 0, 0, 420, 316
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Ogg Input Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_CONFIG_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 7, 406, 270

    LTEXT           "Channel output:", IDC_CONFIG_DECODE_LABEL_CHANNELS, 20, 39, 110, 10
    COMBOBOX        IDC_CONFIG_CHANNELS, 140, 36, 184, 54, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Output rate:", IDC_CONFIG_DECODE_LABEL_RATE, 20, 63, 110, 10
    COMBOBOX        IDC_CONFIG_RATE, 140, 60, 184, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sample depth:", IDC_CONFIG_DECODE_LABEL_BITS, 20, 87, 110, 10
    COMBOBOX        IDC_CONFIG_BITS, 140, 84, 184, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Resampler quality:", IDC_CONFIG_DECODE_LABEL_QUALITY, 20, 111, 110, 10
    CONTROL         "", IDC_CONFIG_QUALITY, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 140, 106, 145, 20
    LTEXT           "", IDC_CONFIG_QUALITY_VALUE, 292, 111, 32, 10
    AUTOCHECKBOX    "Dither integer output (8/16/24/32-bit)", IDC_CONFIG_DITHER, 20, 143, 230, 10, WS_TABSTOP
    AUTOCHECKBOX    "Prevent clipping / peak limit", IDC_CONFIG_PREVENT_CLIPPING, 20, 163, 230, 10, WS_TABSTOP
    AUTOCHECKBOX    "Use enhanced Speex decoding", IDC_CONFIG_ENHANCED_SPEEX, 20, 183, 230, 10, WS_TABSTOP
    AUTOCHECKBOX    "Buffer small local files", IDC_CONFIG_BUFFER_SMALL_FILES, 20, 203, 230, 10, WS_TABSTOP
    AUTOCHECKBOX    "Show instant bitrate where available", IDC_CONFIG_INSTANT_BITRATE, 20, 223, 230, 10, WS_TABSTOP
    AUTOCHECKBOX    "Enable read-only unified information pane", IDC_CONFIG_UNIFIED_INFO, 20, 243, 250, 10, WS_TABSTOP
    AUTOCHECKBOX    "Follow chained source formats (reopen output when needed)", IDC_CONFIG_NATIVE_CHAINS, 20, 260, 365, 10, WS_TABSTOP

    LTEXT           "Dither distribution:", IDC_CONFIG_PDF_LABEL, 20, 39, 110, 10
    COMBOBOX        IDC_CONFIG_DITHER_PDF, 140, 36, 230, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Noise shaping:", IDC_CONFIG_SHAPE_LABEL, 20, 67, 110, 10
    COMBOBOX        IDC_CONFIG_NOISE_SHAPE, 140, 64, 230, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Legacy 5.1 input order (L, R, C, SL, SR, LFE)", IDC_CONFIG_LEGACY_51, 20, 100, 365, 10, WS_TABSTOP
    LTEXT           "Dither must be enabled on the Decoding page. ATH modes fall back to first-order shaping at unsupported rates. DS/DS2 and quad matrices may clip; allow headroom with the preamp.", IDC_CONFIG_PROCESSING_NOTE, 20, 126, 365, 36
    AUTOCHECKBOX    "Preserve exact FLAC PCM (32-bit, no dither or processing)", IDC_CONFIG_EXACT_FLAC, 20, 168, 365, 10, WS_TABSTOP
    AUTOCHECKBOX    "Decode Opus HD at 96 kHz when present", IDC_CONFIG_OPUS_HD, 20, 186, 365, 10, WS_TABSTOP
    AUTOCHECKBOX    "Opus speech enhancement (OSCE, changes decoded audio)", IDC_CONFIG_OPUS_SPEECH, 20, 204, 365, 10, WS_TABSTOP
    AUTOCHECKBOX    "Opus speech BWE (48 kHz only; synthetic high frequencies)", IDC_CONFIG_OPUS_BWE, 20, 222, 365, 10, WS_TABSTOP
    LTEXT           "Ambisonics output:", IDC_CONFIG_AMBISONIC_LABEL, 20, 249, 110, 10
    COMBOBOX        IDC_CONFIG_AMBISONIC, 140, 246, 245, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "ReplayGain mode:", IDC_CONFIG_GAIN_LABEL_MODE, 20, 39, 110, 10
    COMBOBOX        IDC_CONFIG_GAIN_MODE, 140, 36, 184, 105, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Regular preamp (dB):", IDC_CONFIG_GAIN_LABEL_PREAMP, 20, 67, 110, 10
    EDITTEXT        IDC_CONFIG_PREAMP, 140, 64, 80, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Radio preamp (dB):", IDC_CONFIG_GAIN_LABEL_RADIO, 20, 91, 110, 10
    EDITTEXT        IDC_CONFIG_RADIO_PREAMP, 140, 88, 80, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Target loudness (LUFS):", IDC_CONFIG_GAIN_LABEL_TARGET, 20, 115, 110, 10
    EDITTEXT        IDC_CONFIG_TARGET_LUFS, 140, 112, 80, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Peak handling:", IDC_CONFIG_GAIN_LABEL_PEAK, 20, 143, 110, 10
    COMBOBOX        IDC_CONFIG_PEAK_MODE, 140, 140, 230, 82, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Untagged preamp (dB):", IDC_CONFIG_GAIN_LABEL_NON_RG, 20, 167, 110, 10
    EDITTEXT        IDC_CONFIG_NON_RG, 140, 164, 80, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Use only the preferred gain tag (no track / album fallback)", IDC_CONFIG_PREFERRED_ONLY, 20, 191, 350, 10, WS_TABSTOP
    LTEXT           "Preamps accept -60.0 through +30.0 dB. Target accepts -40 through 0 LUFS.", IDC_CONFIG_GAIN_NOTE, 20, 218, 350, 20
    AUTOCHECKBOX    "Use Winamp ReplayGain settings when available", IDC_CONFIG_HOST_REPLAYGAIN, 20, 246, 365, 10, WS_TABSTOP

    LTEXT           "HTTP timeout (ms):", IDC_CONFIG_STREAM_LABEL_TIMEOUT, 20, 39, 110, 10
    EDITTEXT        IDC_CONFIG_TIMEOUT, 150, 36, 88, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Initial probe limit (KiB):", IDC_CONFIG_STREAM_LABEL_PROBE, 20, 63, 124, 10
    EDITTEXT        IDC_CONFIG_PROBE, 150, 60, 88, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Reconnect attempts:", IDC_CONFIG_STREAM_LABEL_ATTEMPTS, 20, 87, 110, 10
    EDITTEXT        IDC_CONFIG_RECONNECT_ATTEMPTS, 150, 84, 88, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Reconnect delay (ms):", IDC_CONFIG_STREAM_LABEL_DELAY, 20, 111, 124, 10
    EDITTEXT        IDC_CONFIG_RECONNECT_DELAY, 150, 108, 88, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Stream buffer (KiB):", IDC_CONFIG_STREAM_LABEL_BUFFER, 20, 135, 110, 10
    EDITTEXT        IDC_CONFIG_STREAM_BUFFER, 150, 132, 88, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Startup prebuffer (KiB):", IDC_CONFIG_STREAM_LABEL_PREBUFFER, 20, 159, 124, 10
    EDITTEXT        IDC_CONFIG_PREBUFFER, 150, 156, 88, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Manual proxy URL (optional):", IDC_CONFIG_STREAM_LABEL_PROXY, 20, 183, 125, 10
    EDITTEXT        IDC_CONFIG_PROXY, 150, 180, 235, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Save incoming streams", IDC_CONFIG_SAVE_STREAMS, 20, 204, 140, 10, WS_TABSTOP
    LTEXT           "Save directory (optional):", IDC_CONFIG_STREAM_LABEL_DIRECTORY, 20, 228, 125, 10
    EDITTEXT        IDC_CONFIG_SAVE_DIRECTORY, 150, 225, 235, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "A blank proxy uses the system proxy. Credentials are never stored.", IDC_CONFIG_STREAM_NOTE, 20, 250, 365, 10

    LTEXT           "Proxy use:", IDC_CONFIG_ADV_LABEL_PROXY_MODE, 20, 39, 110, 10
    COMBOBOX        IDC_CONFIG_PROXY_MODE, 150, 36, 220, 82, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Allow HTTP Range seeking when the server reports a known length", IDC_CONFIG_HTTP_SEEK, 20, 72, 350, 10, WS_TABSTOP
    LTEXT           "Rebuffer threshold (%):", IDC_CONFIG_ADV_LABEL_UNDERRUN, 20, 98, 124, 10
    EDITTEXT        IDC_CONFIG_UNDERRUN_PERCENT, 150, 95, 88, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "These options apply only to HTTP streams. Range seeking depends on server support.", IDC_CONFIG_ADV_NOTE, 20, 128, 365, 20
    AUTOCHECKBOX    "Use Winamp proxy settings when available", IDC_CONFIG_HOST_PROXY, 20, 166, 365, 10, WS_TABSTOP

    DEFPUSHBUTTON   "OK", IDOK, 299, 288, 52, 15, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 358, 288, 55, 15, WS_TABSTOP
END

IDD_ABOUT DIALOGEX 0, 0, 350, 165
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "About Ogg Input"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "", IDC_ABOUT_TEXT, 12, 12, 326, 122
    DEFPUSHBUTTON   "Close", IDOK, 282, 142, 56, 15, WS_TABSTOP
END

IDD_UNIFIED_PANE DIALOGEX 0, 0, 300, 142
STYLE DS_SHELLFONT | WS_CHILD | WS_VISIBLE | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Ogg Information"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "This pane is read-only.", IDC_UNIFIED_SUMMARY, 7, 7, 286, 10
    EDITTEXT        IDC_UNIFIED_DETAILS, 7, 22, 286, 88, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Open File Information...", IDC_UNIFIED_OPEN_INFO, 175, 118, 118, 15, WS_TABSTOP
END
