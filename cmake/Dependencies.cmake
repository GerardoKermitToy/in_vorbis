include(FetchContent)
# The sibling GPL project supplies the four existing pinned audio libraries.
# It remains a separate source repository; no Winamp WCL source is used.
if(NOT TARGET opusfile)
    if(NOT EXISTS "${OGG_INPUT_OPUS_SOURCE}/CMakeLists.txt")
        message(FATAL_ERROR "Set OGG_INPUT_OPUS_SOURCE to the GPL in_opus source tree.")
    endif()
    set(WINAMP_OPUS_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    if(NOT OGG_INPUT_BUILD_OPUS)
        set(WINAMP_OPUS_DEPENDENCIES_ONLY ON CACHE BOOL "" FORCE)
    else()
        set(WINAMP_OPUS_DEPENDENCIES_ONLY OFF CACHE BOOL "" FORCE)
    endif()
    set(WINAMP_OPUS_BUILD_OGG_INPUT OFF)
    add_subdirectory("${OGG_INPUT_OPUS_SOURCE}" "${CMAKE_BINARY_DIR}/opus-project")
endif()
function(ogg_archive name revision hash)
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/downloads/${name}/source.tar.gz")
        set(url "${CMAKE_CURRENT_SOURCE_DIR}/third_party/downloads/${name}/source.tar.gz")
    else()
        string(REGEX REPLACE "-[0-9].*$" "" repo "${name}")
        set(url "https://codeload.github.com/xiph/${repo}/tar.gz/${revision}")
    endif()
    string(REPLACE "-" "_" dep "${name}")
    string(REPLACE "." "_" dep "${dep}")
    FetchContent_Declare(${dep} URL "${url}" URL_HASH "SHA256=${hash}"
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE TLS_VERIFY TRUE DOWNLOAD_DIR "${CMAKE_BINARY_DIR}/downloads/${dep}"
        SOURCE_SUBDIR _populate_only)
    # SOURCE_SUBDIR is deliberately absent: our targets consume the audited sources.
    FetchContent_MakeAvailable(${dep})
    set(${name}_SOURCE "${${dep}_SOURCE_DIR}" PARENT_SCOPE)
endfunction()
